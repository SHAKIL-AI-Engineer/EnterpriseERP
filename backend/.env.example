# ─────────────────────────────────────────────────────────────────────────────
# Enterprise ERP — Docker Environment Configuration Template
# Copy this file to .env and fill in your values before running docker compose.
# DO NOT commit .env with real secrets to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server ────────────────────────────────────────────────────────────────
# Default uses SQL Express on Docker Desktop for Windows (host.docker.internal).
# Change to your server name/IP + port if different.
# Example: ERP_SQL_SERVER=192.168.1.50,1433
ERP_SQL_SERVER=host.docker.internal,1433

# SQL authentication string appended to every connection string.
# Use SQL login (recommended for Docker):
ERP_SQL_AUTH=User Id=erp_docker;Password=erp_dev_password_2026!;Encrypt=Optional;TrustServerCertificate=True;MultipleActiveResultSets=true

# For Windows Authentication instead (host must support it from the container):
# ERP_SQL_AUTH=Trusted_Connection=True;Encrypt=Optional;TrustServerCertificate=True;MultipleActiveResultSets=true

# ── JWT Security ──────────────────────────────────────────────────────────────
# MUST be changed from the default before running in any real environment.
# Must be at least 32 characters long and match across ALL services.
ERP_JWT_SIGNING_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_32+

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=erp
RABBITMQ_DEFAULT_PASS=erp_dev_password

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL that the browser uses to reach the API gateway.
# In Docker Desktop on the same machine, use localhost:5000.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Set a unique bootstrap password before creating the first administrator.
ERP_SEED_SUPERADMIN_PASSWORD=

# Map each actual ERP company GUID to a unique PunchData numeric company ID.
ERP_PUNCH_COMPANY_MAP_JSON={}
